# Production account/region approved for G003.
aws_account_id = "333401878534"
aws_region     = "us-west-2"

# Production hostname is ferry.fyi; staging remains on the same AWS stack for smoke tests.
app_domains = ["ferry.fyi", "staging.ferry.fyi"]
base_url    = "https://ferry.fyi"

# Keep ALB enabled until the Cloudflare Tunnel route is healthy, then disable it to remove ALB/IP charges.
enable_public_alb      = true
enable_https_listener  = true
enable_cloudflare_tunnel = false

# PostgreSQL 17.9 is available in us-west-2 per G003 read-only evidence.
rds_engine_version       = "17.9"
rds_instance_class       = "db.t4g.small"
rds_allocated_storage    = 20
rds_max_allocated_storage = 100

# Keep false for first-create iteration if needed; set true before production cutover.
rds_deletion_protection = false

# CI image tags to deploy from ECR.
image_tag          = "latest"
detector_image_tag = "latest"

# Always-on CPU-only detector service defaults.
detector_desired_count  = 1
detector_cpu            = 1024
detector_memory         = 2048
detector_container_port = 8000

# The GitHub Actions OIDC role is limited to this repo and branch.
github_repository        = "anstosa/ferry.fyi"
github_production_branch = "production"

# OTA artifacts stay private in S3 and are served through CloudFront only.
# Leave the bucket name null to use ferry-fyi-prod-ota-333401878534.
ota_artifact_bucket_name                 = null
ota_immutable_bundle_cache_ttl_seconds   = 31536000
ota_release_cache_ttl_seconds            = 300

# Leave false to avoid putting placeholder secret values into Terraform state.
create_app_secret_placeholder_version = false
# Serve production OTA releases when a client does not name a channel.
ota_default_channel = "production"
