{
  "extends": "../tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "outDir": "../dist/client",
    "rootDir": "..",
    "sourceMap": true,
    "paths": {
      "~/*": [
        "./*"
      ],
      "shared/*": [
        "../shared/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "vite.config.ts"
  ]
}
