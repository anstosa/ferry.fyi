  "scripts": {
    "build": "yarn build:client && yarn build:server",
    "build:android": ". ./android/.envrc && NODE_ENV=production CACHE_NAME=android vite build --config client/vite.config.ts && cap sync && direnv allow",
    "build:client": "NODE_ENV=production vite build --config client/vite.config.ts",
    "build:server": "NODE_ENV=production vite build --config server/vite.config.ts",
    "clean": "rm -rf dist/*",
    "db:migrate": "sequelize db:migrate",
    "db:reset": "./scripts/resetdb.sh",
    "db:start": "node scripts/dev-db.js",
    "db:sync": "curl `heroku pg:backups url --app ferry-fyi` > /tmp/ferryfyi.dump && ./scripts/loaddb.sh /tmp/ferryfyi.dump",
    "db:stop": "node scripts/dev-db.js --stop",
    "generate:icons": "yarn generate:icons:android && yarn generate:icons:ios",
    "generate:icons:android": "npx cordova-res android --icon-background-source '#016f52' --skip-config --copy",
    "generate:icons:ios": "npx cordova-res ios --skip-config --copy",
    "heroku": "cd dist/server && node server.js",
    "heroku-postbuild": "yarn build",
    "heroku:shell": "heroku ps:exec -a ferry-fyi",
    "heroku:restart": "heroku restart -a ferry-fyi",
    "lint": "yarn lint:css && yarn lint:js",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "yarn lint:css --fix",
    "lint:fix": "yarn lint:css:fix && yarn lint:js:fix",
    "lint:js": "yarn lint:js:client && yarn lint:js:server && yarn lint:js:shared",
    "lint:js:client": "cd client && eslint --ext .ts,.tsx .",
    "lint:js:client:fix": "yarn lint:js:client --fix",
    "lint:js:fix": "yarn lint:js:client:fix && yarn lint:js:server:fix && yarn lint:js:shared:fix",
    "lint:js:server": "cd server && eslint --ext .ts,.tsx .",
    "lint:js:server:fix": "yarn lint:js:server --fix",
    "postinstall": "rm -rf node_modules/.vite .cache",
    "reinstall": "rm -rf node_modules client/node_modules server/node_modules shared/node_modules && yarn",
    "android": ". ./android/.envrc && npx cap run android",
    "start:android": ". ./android/.envrc && NODE_ENV=production CACHE_NAME=android vite build --config client/vite.config.ts --watch -- && cap sync",
    "start:client": "NODE_ENV=development vite --config client/vite.config.ts --host 0.0.0.0",
    "start:server": "cd server && node ../scripts/register-esbuild.js devServer.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "yarn type-check:client && yarn type-check:server",
    "type-check:client": "cd client && tsc --project tsconfig.json --noEmit",
    "type-check:server": "cd server && tsc --project tsconfig.json --noEmit",
    "watch:client": "vite build --config client/vite.config.ts --watch",
    "lint:js:shared": "cd shared && eslint --ext .ts,.tsx .",
    "lint:js:shared:fix": "yarn lint:js:shared --fix",
    "start": "node scripts/start-dev.js",
    "start:dev": "node scripts/start-dev.js",
    "weather:backfill": "cd server && node ../scripts/register-esbuild.js scripts/backfillWeather.ts",
    "weather:calculate-adjustments": "cd server && node ../scripts/register-esbuild.js scripts/calculateWeatherAdjustments.ts",
    "tides:backfill": "cd server && node ../scripts/register-esbuild.js scripts/backfillTides.ts",
    "tides:update-forecasts": "cd server && node ../scripts/register-esbuild.js scripts/updateTideForecasts.ts",
    "user-settings:migrate-auth0": "cd server && node ../scripts/register-esbuild.js scripts/migrateAuth0UserSettings.ts"
  },
  "resolutions": {
    "@babel/helper-remap-async-to-generator": "7.29.7",
