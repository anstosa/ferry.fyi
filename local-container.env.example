# Optional Docker Compose environment for docker-compose.dev.yml.
# Copy this file to .env. Every value is available to the app and migration
# containers, while container-only database and detector settings take precedence.

APP_PORT=4041
DETECTOR_PORT=8001
POSTGRES_PORT=5434
ANDROID_CERT_FINGERPRINT=local-container-fingerprint

# Public browser build placeholders. Replace only when testing real integrations.
BASE_URL=http://localhost:4041
AUTH0_CLIENT_AUDIENCE=http://localhost:4041/api
AUTH0_CLIENT_ID=local-container-client
AUTH0_CLIENT_REDIRECT=http://localhost:4041
AUTH0_DOMAIN=local-container.invalid
FIREBASE_API_KEY=local-container-api-key
FIREBASE_APP_ID=local-container-app-id
FIREBASE_PROJECT_ID=local-container-project
FIREBASE_SENDER_ID=local-container-sender
FIREBASE_VAPID_KEY=local-container-vapid-key
GOOGLE_ANALYTICS=
GTM_CONTAINER_ID=
HEROKU_RELEASE_VERSION=LOCAL-CONTAINER
LOG_LEVEL=info
MAPBOX_ACCESS_TOKEN=local-container-mapbox-token
SENTRY_DSN=

# Required only to refresh live Washington State Ferry data.
WSDOT_API_KEY=

# Keep production-style frontend optimization while runtime stays development for local Postgres SSL behavior.
BUILD_NODE_ENV=production
