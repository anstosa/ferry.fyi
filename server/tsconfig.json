{
  "extends": "../tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "../dist/server",
    "rootDir": "..",
    "paths": {
      "~/*": [
        "./*"
      ],
      "shared/*": [
        "../shared/*"
      ]
    },
    "target": "ES6",
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./devServer.ts",
    "vite.config.ts"
  ]
}
